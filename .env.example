# Cumulative .env example for the AI Engineering course.
# Every variable any lab needs ends up here. Each lab's code/ and SDD/ copy is
# a snapshot of the root .env.example from when that lab was built.
#
# To use: copy this file to .env at the repo root, fill in real values.
#   cp .env.example .env

# AWS access key for the IAM user/role with bedrock:InvokeModel permission.
# Generate in IAM console → Users → Security credentials → "Create access key".
AWS_ACCESS_KEY_ID=your-access-key-id-here

# AWS secret access key paired with AWS_ACCESS_KEY_ID. Shown once at creation.
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# AWS region for Bedrock calls. us-east-1 has the broadest model availability;
# us-west-2 is the other common choice. Must match a region where you've been
# granted access to BEDROCK_MODEL_ID.
AWS_REGION=us-east-1

# Bedrock model ID for the default LLM call across labs.
# Find current IDs in the Bedrock console: Discover → Model catalog →
# filter by Amazon → click "Nova 2 Lite". Use the cross-region inference-profile
# ID (the `us.` one below), NOT the bare `amazon.nova-2-lite-v1:0`: Nova 2 Lite
# isn't callable in-region on-demand in us-east-1, so a profile prefix is
# required. (`eu.` / `jp.` / `global.` profiles exist for other regions.)
# fast, cheap reasoning model (course default)
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Nova 2 Pro is preview-only as of this writing — add it here once it's GA in your account.

# Google AI Studio API key. Used by Lesson 2 exercise 01 (raw HTTP) — the
# "an LLM API is just an HTTP POST" example, which hits Gemini because its
# API-key auth is simpler than Bedrock's SigV4 signing. Get a key at:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model ID for exercise 01. Flash is fast and cheap.
GEMINI_MODEL_ID=gemini-3-flash-preview

# Bedrock model ID for text embeddings (Lesson 6+ RAG labs). Titan Text
# Embeddings V2 is called with its bare ID — no `us.` inference profile needed
# (unlike Nova). Enable it in the Bedrock console: Discover → Model catalog →
# Model access → "Titan Text Embeddings V2". If your IAM policy allowlists
# specific models, it must also cover this one.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Lesson 7 (RAG Advanced): Amazon OpenSearch Serverless -------------------
# Lesson 7 moves the vector store off local FAISS onto a managed OpenSearch
# Serverless collection. See the lesson's 00-aws-setup.md for how to create it.

# The collection NAME you chose when creating it. This is the only OpenSearch var
# the lab needs — it resolves the endpoint from this name at runtime, so deleting
# and recreating the collection never makes you edit .env.
OPENSEARCH_COLLECTION=novaops-rag

# OPTIONAL override — leave UNSET for the normal flow (the lab resolves the
# endpoint from OPENSEARCH_COLLECTION). Set it only to pin a specific endpoint,
# e.g. https://abc123def456.us-east-1.aoss.amazonaws.com
# OPENSEARCH_ENDPOINT=

# OPTIONAL — separate credentials for OpenSearch Serverless. Leave BOTH unset for
# the normal case (one AWS account for everything): aoss then uses the AWS_* keys
# above. Set these ONLY if your Bedrock access comes from a SHARED account (a
# different AWS_ACCESS_KEY_ID than your own) while you create the OpenSearch
# collection in your OWN account — put your own account's IAM user keys here, and
# the lab signs every OpenSearch (aoss) call with them while Bedrock keeps using
# the shared AWS_* keys above. Set both together or leave both unset. See the
# lesson's 00-aws-setup.md → "Using shared Bedrock credentials?".
# OPENSEARCH_AWS_ACCESS_KEY_ID=
# OPENSEARCH_AWS_SECRET_ACCESS_KEY=

# --- Lesson 8 (MCP): Model Context Protocol -----------------------------------
# Lesson 8's agent connects to a local MCP server (run from server.py). It uses
# Bedrock (Nova for the agent, Titan for the knowledge-base tool's embeddings) —
# no new required vars. This one is OPTIONAL: leave it UNSET and the client uses
# the local default (http://127.0.0.1:9876/mcp). Set it only to point the agent at
# a different MCP server, e.g. a remote one in the homework.
# MCP_SERVER_URL=http://127.0.0.1:9876/mcp

# NovaOps MCP server that supervisor.py connects to (not a secret).
MCP_SERVER_URL=http://127.0.0.1:9876/mcp
