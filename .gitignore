# Logs, captured output and temporary files
*.log
NULL
*.tmp
tmp/

# Backups (the original course README backup held a credential)
*.bak
*.orig
*~
.README.orig.md

# Editor and OS state
.idea/
.vscode/
.DS_Store
Thumbs.db
